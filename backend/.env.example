# CoachConnect Backend Environment Variables
DJANGO_SECRET_KEY=django-insecure-coachconnect-production-secret-key-change-me
DJANGO_DEBUG=True

# Database Configuration (PostgreSQL or fallback SQLite)
# To use PostgreSQL, set DB_ENGINE=postgresql and provide credentials:
DB_ENGINE=sqlite
POSTGRES_DB=coachconnect
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
